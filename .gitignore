# Credentials and local tooling
.env
.env.*
*.secret
*.pem
*.key
.aws/
.codex/
# Shared agent skills are versioned; other local agent state stays ignored.
/.agents/*
!/.agents/skills/
.venv/
venv/
.idea/
.vscode/

# External simulator, checkpoints, recordings and run artifacts
/RoboTwin/
weights/
videos/
/data/
# The project guide and collaboration notes are versioned; historical docs remain ignored by *.md.
/timings*/
*.safetensors
*.pt
*.pth
*.ckpt
*.mp4
*.avi
*.mov
*.gif
*.log

# Development notes stay local; runtime prompts are executable inputs.
*.md
!/README.md
!/CONTRIBUTE_README.md
!/harness/prompts/*.md
!/.agents/skills/**/*.md
!/docs/Collaboration/*.md

# Python and OS caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/
.DS_Store
aside/
